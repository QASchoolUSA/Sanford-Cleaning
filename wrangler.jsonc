{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "sanford-cleaning",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "sanford-cleaning"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"kv_namespaces": [
		{
			// CF namespace title: BOOKING_OUTBOX_SANFORD
			// Must exist in Workers Builds account 5c25eb28647814ac2579fac5b34d9945
			"binding": "BOOKING_OUTBOX",
			"id": "b9acedc7740443239e8eddb8da80835e"
		}
	],
	"vars": {
		"BOOKING_BROOM_API_KEY": "bb_sanford_dev_key"
	}
}
