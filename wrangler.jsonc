{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "sanford-cleaning",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "sanfordcleaning.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "sanford-cleaning"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	// BOOKING_OUTBOX soft-fallback disabled until a KV namespace exists in this
	// account (5c25eb28647814ac2579fac5b34d9945). Create BOOKING_OUTBOX_SANFORD
	// in the dashboard, then add:
	// "kv_namespaces": [{ "binding": "BOOKING_OUTBOX", "id": "<new-id>" }]
	"vars": {
		"BOOKING_BROOM_API_KEY": "bb_sanford_dev_key",
		"BOOKING_BROOM_URL": "https://app.bookingbroom.com"
	}
}
